#Bashtop Custom Palette theme (Transparent - No Fade)
# Colors from your provided palette
# Main background - empty for transparent
theme[main_bg]=""

# Main text color - dark gray/black
theme[main_fg]="#000000"

# Title color for boxes - black
theme[title]="#000000"

# Highlight color for keyboard shortcuts - blue
theme[hi_fg]="#D73A49"

# Background color of selected items - light gray (semi-transparent effect)
theme[selected_bg]=""

# Foreground color of selected items - dark red/maroon
theme[selected_fg]="#6b3838"

# Color of inactive/disabled text - same as main text (no fade)
theme[inactive_fg]=""

# Color of text appearing on top of graphs - dark for visibility
theme[graph_text]="#2a2a2a"

# Misc colors for processes box
theme[proc_misc]="#000000"

# Box outline colors
theme[cpu_box]="#000000"
theme[mem_box]="#000000"
theme[net_box]="#000000"
theme[proc_box]="#000000"

# Box divider line and small boxes line color
theme[div_line]="#9a9690"

# Temperature graph colors - using sage green to teal
theme[temp_start]="#7a9178"
theme[temp_mid]="#7a9a92"
theme[temp_end]="#5b8dbf"

# CPU graph colors - using mustard/gold to red
theme[cpu_start]="#b89a5a"
theme[cpu_mid]="#8b7a5a"
theme[cpu_end]="#6b3838"

# Mem/Disk free meter - sage green tones
theme[free_start]="#a4b8a0"
theme[free_mid]=""
theme[free_end]="#7a9178"

# Mem/Disk cached meter - blue/teal tones
theme[cached_start]="#7a9a92"
theme[cached_mid]=""
theme[cached_end]="#5b8dbf"

# Mem/Disk available meter - mustard/gold tones
theme[available_start]="#d4c090"
theme[available_mid]=""
theme[available_end]="#b89a5a"

# Mem/Disk used meter - red/maroon tones
theme[used_start]="#8b5050"
theme[used_mid]=""
theme[used_end]="#6b3838"

# Download graph colors - blue tones
theme[download_start]="#89a8c8"
theme[download_mid]="#5b8dbf"
theme[download_end]="#4a6a8a"

# Upload graph colors - purple/mauve tones
theme[upload_start]="#a898a8"
theme[upload_mid]="#8a7a8a"
theme[upload_end]="#6a5a6a"
