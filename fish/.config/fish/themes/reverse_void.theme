# Reverse Void — paper ink theme
set -g fish_color_command        1f1f1f
set -g fish_color_param          6f6788
set -g fish_color_quote          a96b7d
set -g fish_color_error          7a2e2e
set -g fish_color_autosuggestion 8a8a8a
set -g fish_color_operator       5e6f8e
set -g fish_color_escape         a8744f
set -g fish_color_comment        8a8a8a
set -g fish_color_valid_path     5e6f8e
set -g fish_color_redirection    6c8891
set -g fish_pager_color_description 8a8a8a

# Additional colors for completeness
set -g fish_color_end            6f6788
set -g fish_color_keyword        7a2e2e
set -g fish_color_normal         1f1f1f
set -g fish_color_option         5e6f8e
set -g fish_color_selection      --background=d0d0d0
set -g fish_color_search_match   --background=f5f5f5
set -g fish_pager_color_selected_background --background=d0d0d0
set -g fish_pager_color_prefix   5e6f8e
set -g fish_pager_color_completion 1f1f1f
set -g fish_pager_color_progress a96b7d
